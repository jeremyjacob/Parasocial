{
  "name": "@parasocial/app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --port 5173 --strictPort",
    "build": "bun run --cwd ../mcp-local bundle && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
    "test": "bun --bun vitest run",
    "screens": "bun run scripts/screens.ts"
  },
  "devDependencies": {
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/three": "^0.186.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.1",
    "playwright": "1.61.1",
    "svelte": "^5.57.1",
    "svelte-adapter-bun": "^1.0.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@lucide/svelte": "^1.48.0",
    "@parasocial/agent": "workspace:*",
    "@parasocial/api": "workspace:*",
    "@parasocial/assembly": "workspace:*",
    "@parasocial/engine-pool": "workspace:*",
    "@parasocial/kernel": "workspace:*",
    "@parasocial/mcp": "workspace:*",
    "@parasocial/naming": "workspace:*",
    "@parasocial/runtime": "workspace:*",
    "@parasocial/sync": "workspace:*",
    "@parasocial/viewer": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "monaco-editor": "^0.57.0",
    "sharp": "^0.35.4",
    "svelte-toolbelt": "^0.10.6",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "three": "^0.186.1"
  }
}
