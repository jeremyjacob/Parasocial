{
  "name": "parasocial",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*",
    "tests"
  ],
  "scripts": {
    "test": "bun test packages/kernel packages/naming packages/api packages/assembly packages/runtime packages/engine-pool packages/mcp-local tests/corpus",
    "corpus": "bun test tests/corpus",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "bun scripts/dev.ts",
    "prod-local": "bun --cwd packages/app run build && bun scripts/prod-local.ts",
    "gen:migrations": "bun scripts/gen-migrations.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@playwright/test": "^1.63.0",
    "@types/bun": "latest",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.0"
  }
}
