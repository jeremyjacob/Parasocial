# Parasocial — deploy/.env
# Copy to deploy/.env and fill in. Generate secrets with:  openssl rand -base64 48

# ─────────────────────────────────────────────────────────────────────────────
# DOMAIN — ⚠️  CHOOSE ONCE. IT CANNOT CHANGE AFTER INSTALL. ⚠️
#
# Passkeys are bound to this domain (the WebAuthn RP ID). If you change it
# later, EVERY passkey on the instance stops working and nobody can sign in.
# There is no password or email fallback. To move an instance to a new
# domain, export each document (zip), install fresh on the new domain, and
# re-import.
#
# Use "localhost" for local development (passkeys work on localhost without a
# public certificate; Caddy issues a local one).
# ─────────────────────────────────────────────────────────────────────────────
DOMAIN=cad.example.com

# Engine iframe origin (must differ from DOMAIN; same-site is fine). Default: engine.${DOMAIN}
# ENGINE_HOST=engine.cad.example.com

# Postgres (internal network only)
POSTGRES_PASSWORD=change-me-postgres

# App secret: signs blob URLs. >= 32 characters. Rotating it invalidates outstanding signed URLs only.
APP_SECRET=change-me-to-at-least-32-random-characters

# Shared key zero-cache sends to the app's /api/zero/{mutate,query} endpoints.
ZERO_API_KEY=change-me-zero-api-key

# zero-cache admin password (inspector / debug endpoints).
ZERO_ADMIN_PASSWORD=change-me-zero-admin

# Object storage (bundled SeaweedFS S3 gateway). To use S3 or R2 instead, point
# the app's S3_* settings at it in docker-compose.yml and drop the storage services.
S3_BUCKET=parasocial
S3_ACCESS_KEY_ID=parasocial
S3_SECRET_ACCESS_KEY=change-me-storage-secret
