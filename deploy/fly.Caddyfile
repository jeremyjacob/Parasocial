# Routing inside the Fly machine (deploy/fly.Dockerfile). Fly's proxy terminates TLS for both hosts
# and forwards plain HTTP here. The app and the engine origin set their own COOP/COEP/CSP headers.
# Caddy starts before the services (deploy/fly-start.ts), so on a cold start it holds requests and
# retries the upstream until it is up, instead of Fly's proxy backing off on refused connections.
{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	@engine host {$ENGINE_HOST}
	handle @engine {
		reverse_proxy 127.0.0.1:5174 {
			lb_try_duration 90s
			lb_try_interval 250ms
		}
	}

	# Zero client: cacheURL = https://{$DOMAIN}/zero (zero-cache accepts one base path segment).
	handle /zero/* {
		reverse_proxy 127.0.0.1:4848 {
			lb_try_duration 90s
			lb_try_interval 250ms
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000 {
			lb_try_duration 90s
			lb_try_interval 250ms
		}
	}
}
